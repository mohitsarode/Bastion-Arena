# Safe local defaults. Copy to .env only when required. Never commit .env.
BA_ENV=demo
BA_PROVIDER_MODE=fake
BA_CONFIG_PATH=config.yaml
BA_DATABASE_PATH=data/bastion.db
BA_LEDGER_PATH=data/ledger.jsonl

# Optional Ollama profile. Not required for tests or fake demo.
BA_TARGET_BASE_URL=http://localhost:11434/v1
BA_TARGET_MODEL=qwen3:8b
BA_RED_BASE_URL=http://localhost:11434/v1
BA_RED_MODEL=qwen3:8b
BA_BLUE_BASE_URL=http://localhost:11434/v1
BA_BLUE_MODEL=qwen3:8b
BA_EVALUATOR_BASE_URL=http://localhost:11434/v1
BA_EVALUATOR_MODEL=qwen3:8b

# Cloud keys only if cloud mode is explicitly enabled.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
